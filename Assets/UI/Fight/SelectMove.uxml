<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/USS/SelectMoveStyles.uss?fileID=7433441132597879392&amp;guid=d141e88c757744b4c90e76abb674df7a&amp;type=3#SelectMoveStyles"/>
    <ui:VisualElement name="Background" style="flex-grow: 1; background-color: rgb(0, 0, 0);">
        <ui:VisualElement name="TopPanel" style="flex-grow: 1; background-color: rgb(255, 255, 255); height: 50%; flex-direction: column; align-self: center;">
            <ui:VisualElement name="FightScreen" style="flex-grow: 1; height: 100%; aspect-ratio: 1.777778; flex-direction: row;">
                <ui:Image name="Portrait" class="Portrait"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="BottomPanel" style="flex-grow: 1; background-color: rgb(0, 0, 0); flex-direction: row; align-items: auto; justify-content: flex-start; height: 50%;">
            <ui:VisualElement name="BottomLeftPanel" style="flex-grow: 0; width: 66%; height: 100%; align-items: auto; justify-content: center;">
                <ui:VisualElement name="MoveTypeTabs" style="flex-grow: 0; align-items: auto; width: 95%; height: 10%; flex-direction: row; align-self: center; justify-content: flex-start; border-top-width: 4px; border-right-width: 4px; border-bottom-width: 2px; border-left-width: 4px; border-left-color: rgb(255, 255, 255); border-right-color: rgb(255, 255, 255); border-top-color: rgb(255, 255, 255); border-bottom-color: rgb(255, 255, 255);">
                    <ui:Button text="Offensive" name="OffensiveTab" class="Tab" style="padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0;"/>
                    <ui:Button text="Medical" name="MedicalTab" class="Tab" style="padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0;"/>
                    <ui:Button text="Power Up" name="PowerUpTab" class="Tab" style="padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0;"/>
                    <ui:Button text="Summon" name="SummonTab" class="Tab" style="padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0;"/>
                    <ui:Button text="Substitution" name="SubTab" class="Tab" style="padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0;"/>
                    <ui:Button text="Protect" name="ProtectTab" class="Tab" style="padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0;"/>
                </ui:VisualElement>
                <ui:VisualElement name="SubTabs" style="flex-grow: 0; align-items: auto; width: 95%; height: 10%; flex-direction: row; align-self: center; justify-content: flex-start; border-left-color: rgb(255, 255, 255); border-right-color: rgb(255, 255, 255); border-top-color: rgb(255, 255, 255); border-bottom-color: rgb(255, 255, 255); border-top-width: 2px; border-right-width: 4px; border-bottom-width: 2px; border-left-width: 4px;">
                    <ui:Button text="Name" name="NameTab" class="Tab" style="padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0;"/>
                    <ui:Button text="Level" name="LevelTab" class="Tab" style="padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0;"/>
                    <ui:Button text="Mana" name="ManaTab" class="Tab" style="padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0;"/>
                    <ui:Button text="Target" name="TargetTab" class="Tab" style="padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0;"/>
                    <ui:Button text="Type" name="TypeTab" class="Tab" style="padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0;"/>
                </ui:VisualElement>
                <ui:ListView name="MovesListView" fixed-item-height="64" style="width: 95%; height: 70%; align-self: center; background-color: rgb(26, 26, 26); border-top-width: 2px; border-right-width: 4px; border-bottom-width: 4px; border-left-width: 4px; border-left-color: rgb(255, 255, 255); border-right-color: rgb(255, 255, 255); border-top-color: rgb(255, 255, 255); border-bottom-color: rgb(255, 255, 255);"/>
            </ui:VisualElement>
            <ui:VisualElement name="BottomRightPanel" style="flex-grow: 1; width: auto; height: 100%; align-items: auto; justify-content: center;">
                <ui:VisualElement name="BottomRightBordered" style="flex-grow: 0; flex-direction: column; justify-content: flex-start; align-self: stretch; height: 90%; width: 95%; align-content: flex-start; border-left-color: rgb(255, 255, 255); border-right-color: rgb(255, 255, 255); border-top-color: rgb(255, 255, 255); border-bottom-color: rgb(255, 255, 255); border-top-width: 4px; border-right-width: 4px; border-bottom-width: 4px; border-left-width: 4px;">
                    <ui:VisualElement name="HealthHeader" style="flex-grow: 0; flex-direction: row; height: 15%; justify-content: space-evenly; border-left-color: rgb(255, 255, 255); border-right-color: rgb(255, 255, 255); border-top-color: rgb(255, 255, 255); border-bottom-color: rgb(255, 255, 255); border-bottom-width: 4px; background-color: rgb(51, 51, 51);">
                        <ui:Label text="Knight" name="NameLabel" class="HealthLabel" style="font-size: 40px;"/>
                    </ui:VisualElement>
                    <ui:VisualElement name="HealthHeader" style="flex-grow: 0; flex-direction: row; height: 15%; justify-content: space-evenly; border-left-color: rgb(255, 255, 255); border-right-color: rgb(255, 255, 255); border-top-color: rgb(255, 255, 255); border-bottom-color: rgb(255, 255, 255); border-bottom-width: 4px; background-color: rgb(51, 51, 51);">
                        <ui:Label text="Round: 1" name="RoundLabel" class="HealthLabel"/>
                        <ui:Label text="Health: 100" name="HealthLabel" class="HealthLabel"/>
                        <ui:Label text="Mana: 100" name="ManaLabel" class="HealthLabel"/>
                    </ui:VisualElement>
                    <ui:VisualElement name="TargetsHeader" style="flex-grow: 0; flex-direction: row; height: 15%; justify-content: space-evenly; background-color: rgb(26, 26, 26);">
                        <ui:Label text="Select Target" name="SelectTargetLabel" class="HealthLabel"/>
