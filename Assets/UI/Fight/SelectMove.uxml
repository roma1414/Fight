                    <ui:ListView name="TargetsListView" fixed-item-height="64" style="width: 100%; height: auto; align-self: center; background-color: rgb(26, 26, 26); flex-grow: 1;"/>
                    <ui:Button text="Advance" name="AdvanceButton" class="AdvanceButton"/>
